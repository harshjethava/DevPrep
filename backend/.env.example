# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — get from Atlas dashboard
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ── JWT (used only by legacy auth routes; Clerk is the primary auth) ─────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="DevPrep <onboarding@resend.dev>"

# ── Frontend URL (used for CORS whitelist) ────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated extra origins (e.g. staging URL)
# EXTRA_ORIGINS=https://staging.yourapp.com

# ── Clerk ─────────────────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Get from Clerk dashboard → Webhooks → signing secret
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── AI / Groq ─────────────────────────────────────────────────────────────────
# Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile

# ── HuggingFace (optional, not used in production) ───────────────────────────
# HUGGINGFACE_API_KEY=hf_REPLACE_ME
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
